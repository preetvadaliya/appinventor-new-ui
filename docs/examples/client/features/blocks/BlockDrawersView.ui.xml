<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col gap-sm pad-sm">
    <g:Label text="{messages.builtinBlocksLabel}" styleName="drawers-section"/>
    <!-- one BlockDrawerItem per built-in drawer, added in Java -->
    <g:FlowPanel ui:field="builtIn" styleName="col"/>
    <c:Tree ui:field="components"/>
    <g:FlowPanel ui:field="anyComponent" styleName="col"/>
  </g:HTMLPanel>
</ui:UiBinder>
