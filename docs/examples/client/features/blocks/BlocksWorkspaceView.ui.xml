<!-- Blockly is injected into the div; it sizes and scrolls itself. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:HTMLPanel styleName="col grow clip">
    <div ui:field="blockly" class="grow"/>
  </g:HTMLPanel>
</ui:UiBinder>
