<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col gap-sm pad-sm">
    <g:Label ui:field="heading" text="{messages.nonVisibleComponentsHeader}"
        visible="false"/>
    <!-- one IconView per non-visible component, added in Java -->
    <g:FlowPanel ui:field="icons" styleName="row wrap gap-sm"/>
  </g:HTMLPanel>
</ui:UiBinder>
