<!-- PhonePreview: the device frame. The screen being designed (MockForm)
     is put in the slot by the designer; it scrolls inside the frame. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:FlowPanel styleName="phone">
    <g:FlowPanel ui:field="frame" styleName="phone-frame">
      <g:SimplePanel ui:field="screen" styleName="phone-screen"/>
    </g:FlowPanel>
  </g:FlowPanel>
</ui:UiBinder>
