<!-- ViewerView: preview options, the phone, the non-visible components. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:vw="urn:import:com.google.appinventor.client.features.designer.viewer">
  <g:FlowPanel styleName="viewer">
    <vw:ViewerHeader ui:field="header"/>
    <vw:PhonePreview ui:field="phone"/>
    <vw:NonVisibleStrip ui:field="nonVisible"/>
  </g:FlowPanel>
</ui:UiBinder>
