<!-- Options come from ViewerPresenter, not from this template. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="row center wrap gap pad-sm">
    <c:Checkbox ui:field="showHidden"
        label="{messages.showHiddenComponentsCheckbox}"/>
    <c:Select ui:field="deviceSize" label="{messages.previewDeviceSize}"/>
    <c:Select ui:field="previewStyle"
        label="{messages.previewOperatingSystem}"/>
  </g:HTMLPanel>
</ui:UiBinder>
