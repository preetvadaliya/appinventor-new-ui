<!-- ViewerHeader: show hidden components, device size, preview style.
     The options come from ViewerPresenter (today they are hard-coded in
     YaVisibleComponentsPanel.ui.xml). Neo replaces this with its own. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="viewer-header">
    <c:Checkbox ui:field="showHidden"
        label="{messages.showHiddenComponentsCheckbox}"/>
    <c:Select ui:field="deviceSize" label="{messages.previewDeviceSize}"/>
    <c:Select ui:field="previewStyle"
        label="{messages.previewOperatingSystem}"/>
  </g:FlowPanel>
</ui:UiBinder>
