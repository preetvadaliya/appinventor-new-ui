<!-- ComponentTreeView: the screen's components as a tree, then the
     actions for the selected one. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls"
    xmlns:tr="urn:import:com.google.appinventor.client.features.designer.tree">
  <g:FlowPanel styleName="component-tree">
    <c:Tree ui:field="tree" styleName="component-tree-items"/>
    <tr:ComponentActions ui:field="actions"/>
  </g:FlowPanel>
</ui:UiBinder>
