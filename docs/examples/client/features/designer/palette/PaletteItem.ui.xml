<!-- PaletteItem: icon, name, help. Dragged onto the viewer to add a
     component. The icon is a picture or a glyph, from the layout's Icons. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <g:FocusPanel ui:field="item" styleName="palette-item">
    <g:FlowPanel>
      <c:IconView ui:field="icon" styleName="palette-item-icon"/>
      <g:InlineLabel ui:field="name" styleName="palette-item-name"/>
      <c:IconButton ui:field="help" styleName="palette-item-help"/>
    </g:FlowPanel>
  </g:FocusPanel>
</ui:UiBinder>
