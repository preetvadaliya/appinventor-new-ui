<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col gap-sm pad-sm">
    <c:TextField ui:field="search" placeholder="{messages.searchComponents}"/>
    <g:FlowPanel ui:field="results" styleName="col" visible="false"/>
    <!-- one PaletteCategory per category, added in Java -->
    <g:FlowPanel ui:field="categories" styleName="col"/>
    <c:Button ui:field="importExtension" variant="QUIET"
        text="{messages.importExtensionMenuItem}"/>
  </g:HTMLPanel>
</ui:UiBinder>
