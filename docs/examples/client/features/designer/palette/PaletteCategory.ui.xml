<!-- PaletteCategory: one collapsible group (User Interface, Layout …).
     Props: title, open. Items are PaletteItem components added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <c:Collapsible ui:field="group" styleName="palette-category">
    <g:FlowPanel ui:field="items" styleName="palette-category-items"/>
  </c:Collapsible>
</ui:UiBinder>
