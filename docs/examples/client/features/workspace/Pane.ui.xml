<!-- Pane: title bar on top, children below in a scrolling body. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:HTMLPanel styleName="col pane">
    <div class="row center gap-sm pane-header">
      <g:Label ui:field="title" styleName="grow pane-title"/>
      <g:FlowPanel ui:field="actions" styleName="row center gap-xs"/>
    </div>
    <g:FlowPanel ui:field="body" styleName="col grow scroll"/>
  </g:HTMLPanel>
</ui:UiBinder>
