<!-- Pane: a titled panel with an optional row of actions; the body
     scrolls. Replaces widgets/boxes/Box. Each layout styles .pane-* -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:FlowPanel styleName="pane">
    <g:FlowPanel styleName="pane-header">
      <g:Label ui:field="title" styleName="pane-title"/>
      <g:FlowPanel ui:field="actions" styleName="pane-actions"/>
    </g:FlowPanel>
    <g:FlowPanel ui:field="body" styleName="pane-body"/>
  </g:FlowPanel>
</ui:UiBinder>
