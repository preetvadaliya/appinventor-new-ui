<!-- Width and Height: a summary button ("120 pixels") that opens the
     form below. Every controls: element is the active layout's control. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col properties-LengthEditor">
    <controls:Button ui:field="summary"/>

    <!-- Java moves this into the popup (see LengthEditorView). -->
    <gwt:HTMLPanel ui:field="form" styleName="flex-col gap-sm pad-md">
      <controls:Radio ui:field="automatic" text="{messages.automaticCaption}"/>
      <controls:Radio ui:field="fillParent" text="{messages.fillParentCaption}"/>

      <gwt:HTMLPanel styleName="flex-row items-center gap-xs">
        <controls:Radio ui:field="pixels"/>
        <controls:TextField ui:field="pixelsAmount" maxLength="4"/>
        <gwt:InlineLabel text="{messages.pixelsCaption}"/>
      </gwt:HTMLPanel>

      <gwt:HTMLPanel ui:field="percentRow" styleName="flex-row items-center gap-xs">
        <controls:Radio ui:field="percent"/>
        <controls:TextField ui:field="percentAmount" maxLength="4"/>
        <gwt:InlineLabel text="{messages.percentCaption}"/>
      </gwt:HTMLPanel>

      <gwt:Label ui:field="error" styleName="properties-Error" visible="false"/>

      <gwt:HTMLPanel styleName="flex-row justify-end gap-sm">
        <controls:Button ui:field="cancel" text="{messages.cancelButton}"/>
        <controls:Button ui:field="ok" text="{messages.okButton}" variant="PRIMARY"/>
      </gwt:HTMLPanel>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
