<!-- Every number property: one field; its error shows under it.
     controls: is the contracts package, so <controls:TextField> is the active
     layout's field (ClassicTextField, NeoTextField) via SharedView. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <gwt:HTMLPanel styleName="flex-col properties-NumberEditor">
    <controls:TextField ui:field="field"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
