<!-- Every number property: one field; its error shows under it.
     c: is the contracts package, so <c:TextField> is the active
     layout's field (ClassicTextField, NeoTextField) via SharedView. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <g:HTMLPanel styleName="flex-col properties-NumberEditor">
    <c:TextField ui:field="field"/>
  </g:HTMLPanel>
</ui:UiBinder>
