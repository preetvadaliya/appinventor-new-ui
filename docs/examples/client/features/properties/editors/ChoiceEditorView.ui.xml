<!-- Every choice property (36 of them): one select. Its options come
     from the model, so Java fills them. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <g:HTMLPanel styleName="flex-col properties-ChoiceEditor">
    <c:Select ui:field="select"/>
  </g:HTMLPanel>
</ui:UiBinder>
