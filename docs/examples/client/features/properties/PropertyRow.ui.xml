<!-- The editor for this property type goes in the slot. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <g:HTMLPanel styleName="col gap-xs">
    <div class="row center gap-xs">
      <g:Label ui:field="label" styleName="grow property-label"/>
      <c:IconButton ui:field="help"/>
    </div>
    <g:SimplePanel ui:field="editor"/>
  </g:HTMLPanel>
</ui:UiBinder>
