<!-- PropertyRow: label and help, then the editor for this property type
     (ChoiceEditorView, NumberEditorView …) in the slot. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <g:FlowPanel styleName="property">
    <g:FlowPanel styleName="property-header">
      <g:Label ui:field="label" styleName="property-label"/>
      <c:IconButton ui:field="help" styleName="property-help"/>
    </g:FlowPanel>
    <g:SimplePanel ui:field="editor" styleName="property-editor"/>
  </g:FlowPanel>
</ui:UiBinder>
