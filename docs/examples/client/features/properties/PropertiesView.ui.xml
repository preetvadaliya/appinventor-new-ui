<!-- PropertiesView: which component, then its properties by category.
     Categories are PropertyCategory components added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="properties" ui:field="root">
    <g:FlowPanel styleName="properties-header">
      <g:Label ui:field="componentName" styleName="properties-name"/>
      <g:Label ui:field="componentType" styleName="properties-type"/>
    </g:FlowPanel>
    <g:FlowPanel ui:field="categories" styleName="properties-categories"/>
  </g:FlowPanel>
</ui:UiBinder>
