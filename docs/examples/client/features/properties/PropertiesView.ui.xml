<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:HTMLPanel styleName="col">
    <div class="col pad-sm properties-header">
      <g:Label ui:field="componentName" styleName="properties-name"/>
      <g:Label ui:field="componentType" styleName="properties-type"/>
    </div>
    <!-- one PropertyCategory per category, added in Java -->
    <g:FlowPanel ui:field="categories" styleName="col"/>
  </g:HTMLPanel>
</ui:UiBinder>
