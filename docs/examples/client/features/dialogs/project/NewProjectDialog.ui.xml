<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:FlowPanel styleName="dialog-body">
    <!-- Same fields and order as today's NewYoungAndroidProjectWizard -->
    <controls:TextField ui:field="name" label="{messages.projectNameLabel}"/>
    <controls:Select ui:field="toolkit" label="{messages.blocksToolkitTitle}"/>
    <controls:Select ui:field="theme" label="{messages.themeTitle}"/>
    <gwt:FlowPanel styleName="dialog-buttons">
      <controls:Button ui:field="cancel" text="{messages.cancelButton}"/>
      <controls:Button ui:field="create" variant="PRIMARY"
          text="{messages.okButton}"/>
    </gwt:FlowPanel>
  </gwt:FlowPanel>
</ui:UiBinder>
