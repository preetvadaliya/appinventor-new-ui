<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="dialog-body">
    <c:TextField ui:field="name" label="{messages.projectNameLabel}"/>
    <c:Select ui:field="theme" label="{messages.themeLabel}"/>
    <c:Select ui:field="toolkit" label="{messages.toolkitLabel}"/>
    <g:FlowPanel styleName="dialog-buttons">
      <c:Button ui:field="cancel" text="{messages.cancelButton}"/>
      <c:Button ui:field="create" variant="PRIMARY"
          text="{messages.okButton}"/>
    </g:FlowPanel>
  </g:FlowPanel>
</ui:UiBinder>
