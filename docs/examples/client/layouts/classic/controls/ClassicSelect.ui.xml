<!-- ClassicSelect: label and a drop-down list. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel styleName="flex-col gap-xs classic-Select">
    <gwt:Label ui:field="label" styleName="classic-Label"/>
    <gwt:ListBox ui:field="list" styleName="classic-Input"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
