<!-- ClassicMenuButton: caption and a caret; opens ClassicMenu below it. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:FocusPanel ui:field="trigger" styleName="classic-MenuButton">
    <gwt:HTMLPanel styleName="flex-row items-center gap-xs">
      <gwt:InlineLabel ui:field="caption"/>
      <gwt:InlineLabel styleName="classic-MenuButton-caret" text="&#x25BE;"/>
    </gwt:HTMLPanel>
  </gwt:FocusPanel>
</ui:UiBinder>
