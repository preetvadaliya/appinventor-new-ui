<!-- ClassicMenuButton: a <button> with the caption and a caret; opens
     ClassicMenu below it. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel tag="button" ui:field="root"
      styleName="flex-row items-center gap-xs classic-MenuButton">
    <gwt:InlineLabel ui:field="caption"/>
    <gwt:InlineLabel styleName="classic-MenuButton-caret" text="&#x25BE;"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
