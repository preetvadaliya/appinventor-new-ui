<!-- ClassicMenuButton: caption and a caret; opens ClassicMenu below it. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:FocusPanel ui:field="trigger" styleName="classic-MenuButton">
    <g:HTMLPanel styleName="flex-row items-center gap-xs">
      <g:InlineLabel ui:field="caption"/>
      <span class="classic-MenuButton-caret">&#x25BE;</span>
    </g:HTMLPanel>
  </g:FocusPanel>
</ui:UiBinder>
