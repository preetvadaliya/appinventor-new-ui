<!-- ClassicDialog: caption bar with a close button, then the content.
     ClassicDialog.java puts this in a modal popup and adds DialogA11y. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <gwt:HTMLPanel styleName="flex-col classic-Dialog">
    <gwt:HTMLPanel styleName="flex-row items-center classic-Dialog-caption">
      <gwt:Label ui:field="caption" styleName="grow"/>
      <controls:ClassicIconButton ui:field="close"/>
    </gwt:HTMLPanel>
    <gwt:SimplePanel ui:field="content" styleName="flex-col pad-md"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
