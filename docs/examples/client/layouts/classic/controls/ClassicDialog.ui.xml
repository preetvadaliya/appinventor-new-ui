<!-- ClassicDialog: caption bar with a close button, then the content.
     ClassicDialog.java puts this in a modal popup and adds DialogA11y. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <g:HTMLPanel styleName="col classic-Dialog">
    <div class="row center classic-Dialog-caption">
      <g:Label ui:field="caption" styleName="grow"/>
      <c:ClassicIconButton ui:field="close"/>
    </div>
    <g:SimplePanel ui:field="content" styleName="col pad"/>
  </g:HTMLPanel>
</ui:UiBinder>
