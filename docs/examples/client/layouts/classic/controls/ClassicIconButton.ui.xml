<!-- ClassicIconButton: a small square button with one icon (help, close). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ic="urn:import:com.google.appinventor.client.controls">
  <g:FocusPanel ui:field="button" styleName="classic-IconButton">
    <ic:IconView ui:field="icon"/>
  </g:FocusPanel>
</ui:UiBinder>
