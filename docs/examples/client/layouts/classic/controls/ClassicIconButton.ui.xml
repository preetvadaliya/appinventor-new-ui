<!-- ClassicIconButton: a small square button with one icon (help, close). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <gwt:FocusPanel ui:field="button" styleName="classic-IconButton">
    <controls:IconView ui:field="icon"/>
  </gwt:FocusPanel>
</ui:UiBinder>
