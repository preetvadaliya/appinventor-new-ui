<!-- ClassicCollapsible: a header that opens and closes its children
     (palette categories, property categories). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:HTMLPanel styleName="col classic-Collapsible">
    <g:FocusPanel ui:field="header" styleName="classic-Collapsible-header">
      <g:HTMLPanel styleName="row center gap-xs">
        <g:InlineLabel ui:field="caret" text="&#x25B8;"/>
        <g:InlineLabel ui:field="title" styleName="grow"/>
      </g:HTMLPanel>
    </g:FocusPanel>
    <g:FlowPanel ui:field="body" styleName="col" visible="false"/>
  </g:HTMLPanel>
</ui:UiBinder>
