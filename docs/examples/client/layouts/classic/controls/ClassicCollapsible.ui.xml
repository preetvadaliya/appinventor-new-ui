<!-- ClassicCollapsible: a header that opens and closes its children
     (palette categories, property categories). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel styleName="flex-col classic-Collapsible">
    <gwt:FocusPanel ui:field="header" styleName="classic-Collapsible-header">
      <gwt:HTMLPanel styleName="flex-row items-center gap-xs">
        <gwt:InlineLabel ui:field="caret" text="&#x25B8;"/>
        <gwt:InlineLabel ui:field="title" styleName="grow"/>
      </gwt:HTMLPanel>
    </gwt:FocusPanel>
    <gwt:FlowPanel ui:field="body" styleName="flex-col" visible="false"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
