<!-- ClassicMenuItem: one row in a menu; label from the bound action. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:FocusPanel ui:field="item" styleName="classic-MenuItem">
    <gwt:HTMLPanel styleName="flex-row items-center gap-md">
      <gwt:InlineLabel ui:field="label" styleName="grow"/>
      <gwt:InlineLabel ui:field="shortcut" styleName="classic-MenuItem-shortcut"/>
    </gwt:HTMLPanel>
  </gwt:FocusPanel>
</ui:UiBinder>
