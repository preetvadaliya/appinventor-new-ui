<!-- ClassicMenuItem: one row in a menu, a <button role="menuitem">; label
     from the bound action. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel tag="button" ui:field="root"
      styleName="flex-row items-center gap-md classic-MenuItem">
    <gwt:InlineLabel ui:field="label" styleName="grow"/>
    <gwt:InlineLabel ui:field="shortcut" styleName="classic-MenuItem-shortcut"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
