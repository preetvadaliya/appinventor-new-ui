    <c:ClassicMenuItem action="BUILD_AAB"/>
    <c:ClassicMenuSeparator/>
    <c:ClassicMenuItem action="BUILD_APK_2"/>
    <c:ClassicMenuItem action="BUILD_AAB_2"/>
    <c:ClassicMenuSeparator/>
    <c:ClassicMenuItem action="BUILD_IOS_ADHOC"/>
    <c:ClassicMenuItem action="BUILD_IOS_APPSTORE"/>
