<!-- ClassicMainMenu: just the six menus, in order. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:menus="urn:import:com.google.appinventor.client.layouts.classic.views.menus">
  <g:FlowPanel styleName="classic-MainMenu">
    <menus:ClassicProjectsMenu/>
    <menus:ClassicConnectMenu/>
    <menus:ClassicBuildMenu/>
    <menus:ClassicSettingsMenu/>
    <menus:ClassicHelpMenu/>
    <menus:ClassicAdminMenu/>
  </g:FlowPanel>
</ui:UiBinder>
