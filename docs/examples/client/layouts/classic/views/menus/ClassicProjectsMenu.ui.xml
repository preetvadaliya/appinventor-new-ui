<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <c:ClassicMenuButton text="{messages.projectsTabName}" variant="QUIET">
    <c:ClassicMenuItem action="SWITCH_TO_PROJECTS"/>
    <c:ClassicMenuSeparator/>
    <c:ClassicMenuItem action="NEW_PROJECT"/>
    <c:ClassicMenuItem action="IMPORT_PROJECT"/>
    <c:ClassicMenuItem action="IMPORT_TEMPLATE"/>
    <c:ClassicMenuItem action="DELETE_PROJECT"/>
    <c:ClassicMenuItem action="SAVE_PROJECT"/>
    <c:ClassicMenuItem action="SAVE_PROJECT_AS"/>
    <c:ClassicMenuItem action="CHECKPOINT"/>
    <c:ClassicMenuSeparator/>
    <c:ClassicMenuItem action="EXPORT_PROJECT"/>
    <c:ClassicMenuItem action="EXPORT_ALL_PROJECTS"/>
    <c:ClassicMenuSeparator/>
    <c:ClassicMenuItem action="DOWNLOAD_CSR"/>
    <c:ClassicMenuItem action="UPLOAD_KEYSTORE"/>
    <c:ClassicMenuItem action="DOWNLOAD_KEYSTORE"/>
    <c:ClassicMenuItem action="DELETE_KEYSTORE"/>
  </c:ClassicMenuButton>
</ui:UiBinder>
