<!-- ClassicShell: the page. Composes the top bar, the three pages, the
     tutorial and the status bar. No markup of its own beyond the frame. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:top="urn:import:com.google.appinventor.client.layouts.classic.views.topbar"
    xmlns:pr="urn:import:com.google.appinventor.client.layouts.classic.views.projects"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.classic.views.editor"
    xmlns:ad="urn:import:com.google.appinventor.client.layouts.classic.views.admin"
    xmlns:st="urn:import:com.google.appinventor.client.layouts.classic.views.status"
    xmlns:tu="urn:import:com.google.appinventor.client.features.tutorial">
  <g:FlowPanel styleName="classic-Shell">
    <top:ClassicTopBar ui:field="topBar"/>
    <g:FlowPanel styleName="classic-Shell-main">
      <g:FlowPanel styleName="classic-Shell-pages">
        <pr:ClassicProjectsPage ui:field="projectsPage"/>
        <ed:ClassicEditorPage ui:field="editorPage" visible="false"/>
        <ad:ClassicAdminPage ui:field="adminPage" visible="false"/>
      </g:FlowPanel>
      <tu:TutorialPanel ui:field="tutorial" visible="false"/>
    </g:FlowPanel>
    <st:ClassicStatusBar ui:field="statusBar"/>
  </g:FlowPanel>
</ui:UiBinder>
