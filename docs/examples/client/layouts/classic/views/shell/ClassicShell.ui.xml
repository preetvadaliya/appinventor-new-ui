<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:topbar="urn:import:com.google.appinventor.client.layouts.classic.views.topbar"
    xmlns:projects="urn:import:com.google.appinventor.client.layouts.classic.views.projects"
    xmlns:editor="urn:import:com.google.appinventor.client.layouts.classic.views.editor"
    xmlns:admin="urn:import:com.google.appinventor.client.layouts.classic.views.admin"
    xmlns:status="urn:import:com.google.appinventor.client.layouts.classic.views.status"
    xmlns:tutorial="urn:import:com.google.appinventor.client.features.tutorial">
  <gwt:HTMLPanel styleName="flex-col screen classic-Shell">

    <topbar:ClassicTopBar ui:field="topBar"/>

    <gwt:HTMLPanel styleName="flex-row grow">
      <gwt:HTMLPanel styleName="flex-col grow">
        <projects:ClassicProjectsPage ui:field="projectsPage"/>
        <editor:ClassicEditorPage ui:field="editorPage" visible="false"/>
        <admin:ClassicAdminPage ui:field="adminPage" visible="false"/>
      </gwt:HTMLPanel>
      <tutorial:TutorialPanel ui:field="tutorial" visible="false"
          addStyleNames="flex-col overflow-auto classic-Tutorial"/>
    </gwt:HTMLPanel>

    <status:ClassicStatusBar ui:field="statusBar"/>

  </gwt:HTMLPanel>
</ui:UiBinder>
