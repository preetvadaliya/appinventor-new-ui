<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="row center gap">
    <g:Label ui:field="readOnly" styleName="classic-Warning"
        text="{messages.readOnlyMode}" visible="false"/>
    <c:ClassicButton action="SWITCH_TO_PROJECTS" variant="QUIET"
        text="{messages.myProjectsTabName}"/>
    <c:ClassicButton action="VIEW_TRASH" variant="QUIET"
        text="{messages.viewTrashTabName}"/>
    <c:ClassicButton action="OPEN_GUIDE" variant="QUIET"
        text="{messages.guideTabName}"/>
    <c:ClassicButton action="OPEN_FEEDBACK" variant="QUIET"
        text="{messages.feedbackTabName}"/>
  </g:HTMLPanel>
</ui:UiBinder>
