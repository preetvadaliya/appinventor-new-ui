<!-- ClassicAccountMenu: the user's email as the caption, two actions. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <c:ClassicMenuButton ui:field="menu" variant="QUIET">
    <c:ClassicMenuItem action="SIGN_OUT"/>
    <c:ClassicMenuItem action="DELETE_ACCOUNT" variant="DANGER"/>
  </c:ClassicMenuButton>
</ui:UiBinder>
