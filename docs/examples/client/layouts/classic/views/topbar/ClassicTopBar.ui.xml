<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:top="urn:import:com.google.appinventor.client.layouts.classic.views.topbar"
    xmlns:menus="urn:import:com.google.appinventor.client.layouts.classic.views.menus">
  <g:HTMLPanel styleName="row center gap classic-TopBar">
    <top:ClassicLogo/>
    <menus:ClassicMainMenu ui:field="mainMenu"/>

    <div class="row center end grow gap">
      <top:ClassicTopLinks ui:field="links"/>
      <top:ClassicLanguageMenu ui:field="language"/>
      <top:ClassicAccountMenu ui:field="account"/>
    </div>
  </g:HTMLPanel>
</ui:UiBinder>
