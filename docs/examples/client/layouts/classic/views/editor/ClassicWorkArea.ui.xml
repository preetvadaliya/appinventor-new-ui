<!-- ClassicWorkArea: classic's arrangement of the designer and blocks
     panes. Only arrangement lives here; every pane's content is a shared
     view from features/. is-designer / is-blocks picks what shows.
     Designer: palette | viewer | components + assets | properties
     Blocks:   drawers + assets | blocks workspace -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:w="urn:import:com.google.appinventor.client.features.workspace"
    xmlns:pal="urn:import:com.google.appinventor.client.features.designer.palette"
    xmlns:vw="urn:import:com.google.appinventor.client.features.designer.viewer"
    xmlns:tr="urn:import:com.google.appinventor.client.features.designer.tree"
    xmlns:as="urn:import:com.google.appinventor.client.features.assets"
    xmlns:pp="urn:import:com.google.appinventor.client.features.properties"
    xmlns:bl="urn:import:com.google.appinventor.client.features.blocks">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel ui:field="work" styleName="classic-Work is-designer">

    <w:Pane title="{messages.paletteBoxCaption}"
        addStyleNames="classic-Work-palette">
      <pal:PaletteView ui:field="palette"/>
    </w:Pane>

    <w:Pane title="{messages.viewerBoxCaption}" addStyleNames="classic-Work-viewer">
      <vw:ViewerView ui:field="viewer"/>
    </w:Pane>

    <g:FlowPanel styleName="classic-Work-side">
      <w:Pane title="{messages.sourceStructureBoxCaption}"
          addStyleNames="classic-Work-components">
        <tr:ComponentTreeView ui:field="components"/>
      </w:Pane>
      <w:Pane title="{messages.blockSelectorBoxCaption}"
          addStyleNames="classic-Work-drawers">
        <bl:BlockDrawersView ui:field="drawers"/>
      </w:Pane>
      <w:Pane title="{messages.assetListBoxCaption}"
          addStyleNames="classic-Work-assets">
        <as:AssetsView ui:field="assets"/>
      </w:Pane>
    </g:FlowPanel>

    <w:Pane title="{messages.propertiesBoxCaption}"
        addStyleNames="classic-Work-properties">
      <pp:PropertiesView ui:field="properties"/>
    </w:Pane>
  </g:FlowPanel>
</ui:UiBinder>
