<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:w="urn:import:com.google.appinventor.client.features.workspace"
    xmlns:pal="urn:import:com.google.appinventor.client.features.designer.palette">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col w-palette">
    <w:Pane title="{messages.paletteBoxCaption}" addStyleNames="grow">
      <pal:PaletteView ui:field="palette"/>
    </w:Pane>
  </g:HTMLPanel>
</ui:UiBinder>
