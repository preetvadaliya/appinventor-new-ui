<!-- Blockly fills the column and scrolls itself. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:w="urn:import:com.google.appinventor.client.features.workspace"
    xmlns:bl="urn:import:com.google.appinventor.client.features.blocks">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col grow min-viewer">
    <w:Pane title="{messages.viewerBoxCaption}" addStyleNames="grow clip">
      <bl:BlocksWorkspaceView ui:field="workspace"/>
    </w:Pane>
  </g:HTMLPanel>
</ui:UiBinder>
