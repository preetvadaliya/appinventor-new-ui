<!-- Components over media. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:w="urn:import:com.google.appinventor.client.features.workspace"
    xmlns:tr="urn:import:com.google.appinventor.client.features.designer.tree"
    xmlns:as="urn:import:com.google.appinventor.client.features.assets">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col w-side gap-sm">
    <w:Pane title="{messages.sourceStructureBoxCaption}" addStyleNames="grow">
      <tr:ComponentTreeView ui:field="components"/>
    </w:Pane>
    <w:Pane title="{messages.assetListBoxCaption}" addStyleNames="h-media">
      <as:AssetsView ui:field="assets"/>
    </w:Pane>
  </g:HTMLPanel>
</ui:UiBinder>
