<!-- Blocks workspace: Blockly is injected into the div and scrolls itself. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane overflow-hidden">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.viewerBoxCaption}"/>
    </gwt:HTMLPanel>
    <gwt:HTMLPanel ui:field="blockly" styleName="grow"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
