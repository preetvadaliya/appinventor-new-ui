<!-- Blocks workspace: Blockly is injected into the div and scrolls itself. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="flex-col pane overflow-hidden">
    <g:HTMLPanel styleName="flex-row items-center pane-header">
      <g:InlineLabel styleName="pane-title" text="{messages.viewerBoxCaption}"/>
    </g:HTMLPanel>
    <g:HTMLPanel ui:field="blockly" styleName="grow"/>
  </g:HTMLPanel>
</ui:UiBinder>
