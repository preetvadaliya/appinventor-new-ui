<!-- Blocks: drawers over media | blocks workspace -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.classic.views.editor">
  <g:HTMLPanel styleName="flex-row grow gap-sm pad-sm">
    <g:HTMLPanel styleName="flex-col classic-DrawersColumn gap-sm">
      <ed:ClassicBlockDrawers ui:field="drawers" addStyleNames="grow"/>
      <ed:ClassicMedia ui:field="media" addStyleNames="classic-MediaPane"/>
    </g:HTMLPanel>
    <ed:ClassicBlocksWorkspace ui:field="workspace" addStyleNames="grow classic-ViewerColumn"/>
  </g:HTMLPanel>
</ui:UiBinder>
