<!-- Blocks: drawers over media | blocks workspace -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:editor="urn:import:com.google.appinventor.client.layouts.classic.views.editor">
  <gwt:HTMLPanel styleName="flex-row grow gap-sm pad-sm">
    <gwt:HTMLPanel styleName="flex-col classic-DrawersColumn gap-sm">
      <editor:ClassicBlockDrawers ui:field="drawers" addStyleNames="grow"/>
      <editor:ClassicMedia ui:field="media" addStyleNames="classic-MediaPane"/>
    </gwt:HTMLPanel>
    <editor:ClassicBlocksWorkspace ui:field="workspace" addStyleNames="grow classic-ViewerColumn"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
