<!-- Properties: which component, then its properties by category.
     Categories and rows (ClassicPropertyRow) are added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.propertiesBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col pad-sm classic-PropertiesHeader">
      <gwt:Label ui:field="componentName" styleName="classic-Title"/>
      <gwt:Label ui:field="componentType" styleName="classic-Muted"/>
    </gwt:HTMLPanel>

    <gwt:FlowPanel ui:field="categories" styleName="flex-col grow overflow-auto"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
