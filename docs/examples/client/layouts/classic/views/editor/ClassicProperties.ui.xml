<!-- Properties: which component, then its properties by category.
     Categories and rows (ClassicPropertyRow) are added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col pane">
    <div class="row center pane-header">
      <span class="pane-title"><ui:text from="{messages.propertiesBoxCaption}"/></span>
    </div>

    <div class="col pad-sm classic-PropertiesHeader">
      <g:Label ui:field="componentName" styleName="classic-Title"/>
      <g:Label ui:field="componentType" styleName="classic-Muted"/>
    </div>

    <g:FlowPanel ui:field="categories" styleName="col grow scroll"/>
  </g:HTMLPanel>
</ui:UiBinder>
