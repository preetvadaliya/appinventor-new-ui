<!-- Viewer: preview options, the phone, the non-visible components. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.viewerBoxCaption}"/>
    </gwt:HTMLPanel>

    <!-- options are filled by ViewerPresenter -->
    <gwt:HTMLPanel styleName="flex-row items-center flex-wrap gap-md pad-sm">
      <controls:ClassicCheckbox ui:field="showHidden"
          label="{messages.showHiddenComponentsCheckbox}"/>
      <controls:ClassicSelect ui:field="deviceSize" label="{messages.previewDeviceSize}"/>
      <controls:ClassicSelect ui:field="previewStyle"
          label="{messages.previewOperatingSystem}"/>
    </gwt:HTMLPanel>

    <!-- the phone; the screen being designed (MockForm) goes in the slot -->
    <gwt:HTMLPanel styleName="flex-row grow overflow-auto pad-md">
      <gwt:HTMLPanel styleName="flex-col classic-PhoneFrame">
        <gwt:SimplePanel ui:field="screen" styleName="flex-col grow"/>
      </gwt:HTMLPanel>
    </gwt:HTMLPanel>

    <!-- non-visible components (Clock, TinyDB …), added in Java -->
    <gwt:HTMLPanel styleName="flex-col gap-sm pad-sm">
      <gwt:Label ui:field="nonVisibleHeading" visible="false"
          text="{messages.nonVisibleComponentsHeader}"/>
      <gwt:FlowPanel ui:field="nonVisible" styleName="flex-row flex-wrap gap-sm"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
