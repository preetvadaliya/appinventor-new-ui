<!-- Palette: search, then the component categories. Categories and their
     items (ClassicPaletteItem) are added in Java from the component list. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col pane">
    <div class="row center pane-header">
      <span class="pane-title"><ui:text from="{messages.paletteBoxCaption}"/></span>
    </div>

    <div class="col grow scroll gap-sm pad-sm">
      <c:ClassicTextField ui:field="search"
          placeholder="{messages.searchComponents}"/>
      <g:FlowPanel ui:field="results" styleName="col" visible="false"/>
      <g:FlowPanel ui:field="categories" styleName="col"/>
      <c:ClassicButton ui:field="importExtension" variant="QUIET"
          text="{messages.importExtensionMenuItem}"/>
    </div>
  </g:HTMLPanel>
</ui:UiBinder>
