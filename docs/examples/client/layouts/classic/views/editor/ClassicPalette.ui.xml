<!-- Palette: search, then the component categories. Categories and their
     items (ClassicPaletteItem) are added in Java from the component list. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.paletteBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col grow overflow-auto gap-sm pad-sm">
      <controls:ClassicTextField ui:field="search"
          placeholder="{messages.searchComponents}"/>
      <gwt:FlowPanel ui:field="results" styleName="flex-col" visible="false"/>
      <gwt:FlowPanel ui:field="categories" styleName="flex-col"/>
      <controls:ClassicButton ui:field="importExtension" variant="QUIET"
          text="{messages.importExtensionMenuItem}"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
