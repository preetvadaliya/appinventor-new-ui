<!-- Media: the project's files and the upload button. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.assetListBoxCaption}"/>
    </gwt:HTMLPanel>

    <controls:ClassicTree ui:field="files" addStyleNames="grow overflow-auto"/>

    <gwt:HTMLPanel styleName="flex-row pad-sm">
      <controls:ClassicButton ui:field="upload" text="{messages.addButton}"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
