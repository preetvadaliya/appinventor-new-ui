<!-- One property: label and help, then its editor (ChoiceEditorView …). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <gwt:HTMLPanel styleName="flex-col gap-xs pad-sm">
    <gwt:HTMLPanel styleName="flex-row items-center gap-xs">
      <gwt:Label ui:field="label" styleName="grow classic-PropertyLabel"/>
      <controls:ClassicIconButton ui:field="help"/>
    </gwt:HTMLPanel>
    <gwt:SimplePanel ui:field="editor"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
