<!-- Blocks drawers: built-in drawers, then one per component. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="flex-col pane">
    <div class="flex-row items-center pane-header">
      <span class="pane-title"><ui:text from="{messages.blockSelectorBoxCaption}"/></span>
    </div>

    <div class="flex-col grow overflow-auto gap-sm pad-sm">
      <g:Label text="{messages.builtinBlocksLabel}" styleName="classic-Muted"/>
      <!-- Control, Logic, Math … added in Java, each with its icon -->
      <g:FlowPanel ui:field="builtIn" styleName="flex-col"/>
      <c:ClassicTree ui:field="components"/>
    </div>
  </g:HTMLPanel>
</ui:UiBinder>
