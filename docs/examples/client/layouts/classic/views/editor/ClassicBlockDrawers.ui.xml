<!-- Blocks drawers: built-in drawers, then one per component. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.blockSelectorBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col grow overflow-auto gap-sm pad-sm">
      <gwt:Label text="{messages.builtinBlocksLabel}" styleName="classic-Muted"/>
      <!-- Control, Logic, Math … added in Java, each with its icon -->
      <gwt:FlowPanel ui:field="builtIn" styleName="flex-col"/>
      <controls:ClassicTree ui:field="components"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
