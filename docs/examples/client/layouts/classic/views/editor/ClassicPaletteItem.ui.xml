<!-- One component in the palette: icon, name, help. Drag to the viewer. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls"
    xmlns:ic="urn:import:com.google.appinventor.client.controls">
  <g:FocusPanel ui:field="item" styleName="classic-PaletteItem">
    <g:HTMLPanel styleName="row center gap-sm">
      <ic:IconView ui:field="icon"/>
      <g:InlineLabel ui:field="name" styleName="grow"/>
      <c:ClassicIconButton ui:field="help"/>
    </g:HTMLPanel>
  </g:FocusPanel>
</ui:UiBinder>
