<!-- ClassicDesignToolbar: project name, screen controls, editor switch. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.classic.views.editor">
  <g:FlowPanel styleName="classic-DesignToolbar">
    <g:Label ui:field="projectName" styleName="classic-DesignToolbar-project"/>
    <ed:ClassicScreenControls ui:field="screens"/>
    <ed:ClassicEditorSwitch ui:field="editorSwitch"/>
  </g:FlowPanel>
</ui:UiBinder>
