<!-- Designer toolbar: project name, screens, then Designer / Blocks. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="row center gap pad classic-DesignToolbar">

    <g:Label ui:field="projectName" styleName="classic-Title"/>

    <div class="row center gap-sm grow">
      <c:ClassicButton action="TOGGLE_TUTORIAL"/>
      <!-- the project's screens are added in Java -->
      <c:ClassicMenuButton ui:field="screens" text="{messages.screensButton}"/>
      <c:ClassicButton action="ADD_SCREEN"/>
      <c:ClassicButton action="REMOVE_SCREEN"/>
      <c:ClassicButton action="PROJECT_PROPERTIES"/>
      <c:ClassicButton action="SEND_TO_GALLERY"/>
    </div>

    <div class="row center gap-sm">
      <c:ClassicButton action="TOGGLE_CONSOLE"/>
      <c:ClassicButton action="SWITCH_TO_DESIGNER"/>
      <c:ClassicButton action="SWITCH_TO_BLOCKS"/>
    </div>

  </g:HTMLPanel>
</ui:UiBinder>
