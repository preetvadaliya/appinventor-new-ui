<!-- Designer toolbar: project name, screens, then Designer / Blocks. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-row items-center gap-md pad-md classic-DesignToolbar">

    <gwt:Label ui:field="projectName" styleName="classic-Title"/>

    <gwt:HTMLPanel styleName="flex-row items-center gap-sm grow">
      <controls:ClassicButton action="TOGGLE_TUTORIAL"/>
      <!-- the project's screens are added in Java -->
      <controls:ClassicMenuButton ui:field="screens" text="{messages.screensButton}"/>
      <controls:ClassicButton action="ADD_SCREEN"/>
      <controls:ClassicButton action="REMOVE_SCREEN"/>
      <controls:ClassicButton action="PROJECT_PROPERTIES"/>
      <controls:ClassicButton action="SEND_TO_GALLERY"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-row items-center gap-sm">
      <controls:ClassicButton action="TOGGLE_CONSOLE"/>
      <controls:ClassicButton action="SWITCH_TO_DESIGNER"/>
      <controls:ClassicButton action="SWITCH_TO_BLOCKS"/>
    </gwt:HTMLPanel>

  </gwt:HTMLPanel>
</ui:UiBinder>
