<!-- Like React: {mode === DESIGNER ? <Designer/> : <Blocks/>}.
     Two separate areas instead of one area with hidden panes. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.classic.views.editor"
    xmlns:con="urn:import:com.google.appinventor.client.features.console">
  <g:HTMLPanel styleName="flex-col grow">
    <ed:ClassicDesignToolbar ui:field="toolbar"/>

    <ed:ClassicDesignerArea ui:field="designer"/>
    <ed:ClassicBlocksArea ui:field="blocks" visible="false"/>

    <con:ConsolePanel ui:field="console" visible="false"
        addStyleNames="overflow-auto classic-Console"/>
  </g:HTMLPanel>
</ui:UiBinder>
