<!-- Components: the screen's components as a tree; Rename and Delete. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col pane">
    <gwt:HTMLPanel styleName="flex-row items-center pane-header">
      <gwt:InlineLabel styleName="pane-title" text="{messages.sourceStructureBoxCaption}"/>
    </gwt:HTMLPanel>

    <controls:ClassicTree ui:field="tree" addStyleNames="grow overflow-auto"/>

    <gwt:HTMLPanel styleName="flex-row items-center gap-sm pad-sm">
      <controls:ClassicButton ui:field="rename" text="{messages.renameButton}"/>
      <controls:ClassicButton ui:field="delete" variant="DANGER"
          text="{messages.deleteButton}"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
