<!-- Designer: palette | viewer | components over media | properties -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.classic.views.editor">
  <g:HTMLPanel styleName="row grow gap-sm pad-sm">
    <ed:ClassicPalette ui:field="palette" addStyleNames="w-palette"/>
    <ed:ClassicViewer ui:field="viewer" addStyleNames="grow min-viewer"/>
    <div class="col w-side gap-sm">
      <ed:ClassicComponentTree ui:field="components" addStyleNames="grow"/>
      <ed:ClassicMedia ui:field="media" addStyleNames="h-media"/>
    </div>
    <ed:ClassicProperties ui:field="properties" addStyleNames="w-properties"/>
  </g:HTMLPanel>
</ui:UiBinder>
