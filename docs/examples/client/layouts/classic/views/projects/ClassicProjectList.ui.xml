<!-- Project list: column headers, then the rows (they scroll).
     Rows are ClassicProjectRow / ClassicProjectFolder, one per item. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="flex-col classic-ProjectList">

    <g:HTMLPanel styleName="flex-row items-center classic-ListHeader">
      <c:ClassicCheckbox ui:field="selectAll"/>
      <g:FocusPanel ui:field="sortByName" styleName="grow classic-SortHeader">
        <g:InlineLabel ui:field="nameHeader" text="{messages.projectNameHeader}"/>
      </g:FocusPanel>
      <g:FocusPanel ui:field="sortByCreated" styleName="classic-DateColumn classic-SortHeader">
        <g:InlineLabel ui:field="createdHeader"
            text="{messages.projectDateCreatedHeader}"/>
      </g:FocusPanel>
      <g:FocusPanel ui:field="sortByModified" styleName="classic-DateColumn classic-SortHeader">
        <g:InlineLabel ui:field="modifiedHeader"
            text="{messages.projectDateModifiedHeader}"/>
      </g:FocusPanel>
    </g:HTMLPanel>

    <g:FlowPanel ui:field="rows" styleName="flex-col grow overflow-auto"/>

    <g:Label ui:field="empty" styleName="classic-Empty"
        text="{messages.createNoProjectsDialogText}" visible="false"/>

  </g:HTMLPanel>
</ui:UiBinder>
