<!-- ClassicProjectList: fixed header, scrolling rows, and an empty state.
     Rows and folders are added in Java, one ClassicProjectRow or
     ClassicProjectFolder per item (like a map() over the list). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:pr="urn:import:com.google.appinventor.client.layouts.classic.views.projects">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="classic-ProjectList">
    <pr:ClassicProjectListHeader ui:field="header"/>
    <g:FlowPanel ui:field="rows" styleName="classic-ProjectList-rows"/>
    <g:Label ui:field="empty" styleName="classic-ProjectList-empty"
        text="{messages.createNoProjectsDialogText}" visible="false"/>
  </g:FlowPanel>
</ui:UiBinder>
