<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:pr="urn:import:com.google.appinventor.client.layouts.classic.views.projects">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="col classic-ProjectList">
    <pr:ClassicProjectListHeader ui:field="header"/>

    <!-- rows: one ClassicProjectRow / ClassicProjectFolder per item -->
    <g:FlowPanel ui:field="rows" styleName="col grow scroll"/>

    <g:Label ui:field="empty" styleName="classic-Empty"
        text="{messages.createNoProjectsDialogText}" visible="false"/>
  </g:HTMLPanel>
</ui:UiBinder>
