<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls"
    xmlns:pr="urn:import:com.google.appinventor.client.layouts.classic.views.projects">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:HTMLPanel styleName="row center classic-ListHeader">
    <c:ClassicCheckbox ui:field="selectAll"/>
    <pr:ClassicSortHeader ui:field="name" column="NAME" addStyleNames="grow"
        label="{messages.projectNameHeader}"/>
    <pr:ClassicSortHeader ui:field="created" column="DATE_CREATED"
        addStyleNames="w-date" label="{messages.projectDateCreatedHeader}"/>
    <pr:ClassicSortHeader ui:field="modified" column="DATE_MODIFIED"
        addStyleNames="w-date" label="{messages.projectDateModifiedHeader}"/>
  </g:HTMLPanel>
</ui:UiBinder>
