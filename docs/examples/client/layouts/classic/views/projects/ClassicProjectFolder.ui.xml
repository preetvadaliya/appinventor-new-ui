<!-- ClassicProjectFolder: a folder row plus its children, which are more
     ClassicProjectRow / ClassicProjectFolder components added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:c="urn:import:com.google.appinventor.client.layouts.classic.controls"
    xmlns:ic="urn:import:com.google.appinventor.client.controls">
  <g:FlowPanel styleName="classic-ProjectFolder">
    <g:FocusPanel ui:field="row" styleName="classic-ProjectRow">
      <g:FlowPanel>
        <c:ClassicCheckbox ui:field="selected"/>
        <ic:IconView ui:field="expander" styleName="classic-ProjectFolder-expander"/>
        <ic:IconView ui:field="folderIcon" styleName="classic-ProjectFolder-icon"/>
        <g:Label ui:field="name" styleName="classic-ProjectRow-name"/>
        <g:Label ui:field="created" styleName="classic-ProjectRow-date"/>
        <g:Label ui:field="modified" styleName="classic-ProjectRow-date"/>
      </g:FlowPanel>
    </g:FocusPanel>
    <g:FlowPanel ui:field="children" styleName="classic-ProjectFolder-children"
        visible="false"/>
  </g:FlowPanel>
</ui:UiBinder>
