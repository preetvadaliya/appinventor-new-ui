<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls"
    xmlns:shared="urn:import:com.google.appinventor.client.controls">
  <gwt:HTMLPanel styleName="flex-col">
    <gwt:FocusPanel ui:field="row" styleName="classic-Row">
      <gwt:HTMLPanel styleName="flex-row items-center gap-xs">
        <controls:ClassicCheckbox ui:field="selected"/>
        <shared:IconView ui:field="expander"/>
        <shared:IconView ui:field="folderIcon"/>
        <gwt:Label ui:field="name" styleName="grow"/>
        <gwt:Label ui:field="created" styleName="classic-DateColumn"/>
        <gwt:Label ui:field="modified" styleName="classic-DateColumn"/>
      </gwt:HTMLPanel>
    </gwt:FocusPanel>

    <!-- children: more rows and folders, indented -->
    <gwt:FlowPanel ui:field="children" styleName="flex-col classic-Indent"
        visible="false"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
