<!-- ClassicSortHeader: one clickable column title with a sort arrow.
     Props: column, label. State: setSort(NONE | ASCENDING | DESCENDING). -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui">
  <g:FocusPanel ui:field="button" styleName="classic-SortHeader">
    <g:FlowPanel>
      <g:InlineLabel ui:field="label" styleName="classic-SortHeader-label"/>
      <g:InlineLabel ui:field="arrow" styleName="classic-SortHeader-arrow"/>
    </g:FlowPanel>
  </g:FocusPanel>
</ui:UiBinder>
