<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.classic.controls">
  <gwt:HTMLPanel styleName="flex-row items-center gap-md pad-md classic-ProjectToolbar">
    <gwt:Label ui:field="title" styleName="classic-Title"/>

    <gwt:HTMLPanel ui:field="projectButtons" styleName="flex-row items-center gap-sm">
      <controls:ClassicButton action="NEW_PROJECT"/>
      <controls:ClassicButton action="NEW_FOLDER"/>
      <controls:ClassicButton action="MOVE_PROJECTS"/>
      <controls:ClassicButton action="DELETE_PROJECT"/>
      <controls:ClassicButton action="VIEW_TRASH"/>
      <controls:ClassicButton action="LOGIN_TO_GALLERY"/>
      <controls:ClassicButton action="SEND_TO_GALLERY"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel ui:field="trashButtons" styleName="flex-row items-center gap-sm" visible="false">
      <controls:ClassicButton action="SWITCH_TO_PROJECTS"/>
      <controls:ClassicButton action="RESTORE_PROJECT"/>
      <controls:ClassicButton action="DELETE_FOREVER"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
