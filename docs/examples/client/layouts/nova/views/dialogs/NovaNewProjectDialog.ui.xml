<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:shared="urn:import:com.google.appinventor.client.controls"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.nova.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:FlowPanel styleName="nova-Dialog">

    <!-- Header: icon, title, one line of help -->
    <gwt:FlowPanel styleName="nova-Dialog-header">
      <shared:IconView ui:field="icon" styleName="nova-Dialog-icon"/>
      <gwt:FlowPanel styleName="nova-Dialog-heading">
        <gwt:Label styleName="nova-Dialog-title"
            text="{messages.newYoungAndroidProjectWizardCaption}"/>
        <gwt:Label styleName="nova-Dialog-description"
            text="{messages.newProjectDescription}"/>
      </gwt:FlowPanel>
    </gwt:FlowPanel>

    <gwt:HTML styleName="nova-Separator"/>

    <!-- Content: labels above fields, full width -->
    <gwt:FlowPanel styleName="nova-Dialog-content">
      <controls:NovaTextField ui:field="name" label="{messages.projectNameLabel}"/>
      <controls:NovaSelect ui:field="toolkit" label="{messages.blocksToolkitTitle}"/>
      <controls:NovaSelect ui:field="theme" label="{messages.themeTitle}"/>
    </gwt:FlowPanel>

    <gwt:HTML styleName="nova-Separator"/>

    <!-- Footer: actions on the right, the main one last -->
    <gwt:FlowPanel styleName="nova-Dialog-footer">
      <controls:NovaButton ui:field="cancel" variant="QUIET"
          text="{messages.cancelButton}"/>
      <controls:NovaButton ui:field="create" variant="PRIMARY"
          text="{messages.createProjectButton}"/>
    </gwt:FlowPanel>
  </gwt:FlowPanel>
</ui:UiBinder>
