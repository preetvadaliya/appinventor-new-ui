<!-- Top bar: logo, main menu, then Help, language and account on the
     right. Neo keeps Help here instead of in the main menu. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls"
    xmlns:menus="urn:import:com.google.appinventor.client.layouts.neo.views.menus">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-row items-center gap-md neo-TopBar">

    <gwt:Image ui:field="logo" styleName="neo-Logo"/>

    <menus:NeoMainMenu ui:field="mainMenu"/>

    <gwt:HTMLPanel styleName="flex-row items-center justify-end grow gap-sm">
      <gwt:Label ui:field="readOnly" styleName="neo-Warning"
          text="{messages.readOnlyMode}" visible="false"/>

      <controls:NeoMenuButton ui:field="help" text="{messages.helpTabName}"
          variant="QUIET">
        <controls:NeoMenuItem action="ABOUT"/>
        <controls:NeoMenuSeparator/>
        <controls:NeoMenuItem action="OPEN_LIBRARY"/>
        <controls:NeoMenuItem action="OPEN_GET_STARTED"/>
        <controls:NeoMenuItem action="OPEN_EXTENSIONS"/>
        <controls:NeoMenuItem action="OPEN_TUTORIALS"/>
        <controls:NeoMenuItem action="OPEN_TROUBLESHOOTING"/>
        <controls:NeoMenuItem action="OPEN_FORUMS"/>
        <controls:NeoMenuItem action="OPEN_GUIDE"/>
        <controls:NeoMenuSeparator/>
        <controls:NeoMenuItem action="OPEN_FEEDBACK"/>
        <controls:NeoMenuSeparator/>
        <controls:NeoMenuItem action="COMPANION_INFO"/>
        <controls:NeoMenuItem action="COMPANION_UPDATE"/>
        <controls:NeoMenuItem action="SHOW_SPLASH"/>
        <controls:NeoMenuItem action="SHOW_SHORTCUTS"/>
      </controls:NeoMenuButton>

      <!-- languages are added in Java; they come from the server -->
      <controls:NeoMenuButton ui:field="language" variant="QUIET"/>

      <controls:NeoMenuButton ui:field="account" variant="QUIET">
        <controls:NeoMenuItem action="SIGN_OUT"/>
        <controls:NeoMenuItem action="DELETE_ACCOUNT" variant="DANGER"/>
      </controls:NeoMenuButton>
    </gwt:HTMLPanel>

  </gwt:HTMLPanel>
</ui:UiBinder>
