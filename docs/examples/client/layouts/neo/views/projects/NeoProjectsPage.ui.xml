<!-- Projects page: toolbar stays put, the list scrolls inside its card. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:projects="urn:import:com.google.appinventor.client.layouts.neo.views.projects">
  <gwt:FlowPanel styleName="neo-Page neo-ProjectsPage">
    <projects:NeoProjectToolbar ui:field="toolbar"/>
    <gwt:FlowPanel styleName="neo-Card">
      <projects:NeoProjectList ui:field="list" styleName="neo-Scroll"/>
    </gwt:FlowPanel>
  </gwt:FlowPanel>
</ui:UiBinder>
