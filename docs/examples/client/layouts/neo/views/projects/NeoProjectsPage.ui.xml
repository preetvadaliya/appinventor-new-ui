<!-- Projects page: the toolbar stays put, the list card scrolls inside. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:projects="urn:import:com.google.appinventor.client.layouts.neo.views.projects">
  <gwt:HTMLPanel styleName="flex-col grow gap-md pad-md">
    <projects:NeoProjectToolbar ui:field="toolbar"/>
    <projects:NeoProjectList ui:field="list" addStyleNames="grow"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
