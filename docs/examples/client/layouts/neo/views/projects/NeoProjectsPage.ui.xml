<!-- Projects page: toolbar stays put, the list scrolls inside its card. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:pr="urn:import:com.google.appinventor.client.layouts.neo.views.projects">
  <g:FlowPanel styleName="neo-Page neo-ProjectsPage">
    <pr:NeoProjectToolbar ui:field="toolbar"/>
    <g:FlowPanel styleName="neo-Card">
      <pr:NeoProjectList ui:field="list" styleName="neo-Scroll"/>
    </g:FlowPanel>
  </g:FlowPanel>
</ui:UiBinder>
