<!-- One project: checkbox, name, dates. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <gwt:FocusPanel ui:field="row" styleName="neo-Row">
    <gwt:HTMLPanel styleName="flex-row items-center gap-sm">
      <controls:NeoCheckbox ui:field="selected"/>
      <gwt:Label ui:field="name" styleName="grow"/>
      <gwt:Label ui:field="created" styleName="neo-DateColumn"/>
      <gwt:Label ui:field="modified" styleName="neo-DateColumn"/>
    </gwt:HTMLPanel>
  </gwt:FocusPanel>
</ui:UiBinder>
