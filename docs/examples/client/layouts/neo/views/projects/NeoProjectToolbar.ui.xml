<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:FlowPanel styleName="neo-ProjectToolbar">
    <gwt:Label ui:field="title" styleName="neo-ProjectToolbar-title"/>

    <gwt:FlowPanel ui:field="projectButtons" styleName="neo-ProjectToolbar-groups">
      <gwt:FlowPanel styleName="neo-ProjectToolbar-start">
        <controls:NeoButton action="NEW_PROJECT" variant="PRIMARY"/>
        <controls:NeoButton action="IMPORT_PROJECT"/>
        <controls:NeoButton action="IMPORT_TEMPLATE"/>
        <controls:NeoButton action="NEW_FOLDER"/>
      </gwt:FlowPanel>
      <gwt:FlowPanel styleName="neo-ProjectToolbar-center">
        <controls:NeoButton action="MOVE_PROJECTS"/>
        <controls:NeoMenuButton action="EXPORT">
          <controls:NeoMenuItem action="EXPORT_PROJECT"/>
          <controls:NeoMenuItem action="EXPORT_ALL_PROJECTS"/>
        </controls:NeoMenuButton>
        <controls:NeoButton action="LOGIN_TO_GALLERY"
            text="{messages.galleryTabName}"/>
        <controls:NeoButton action="SEND_TO_GALLERY"
            text="{messages.publishButton}"/>
      </gwt:FlowPanel>
      <gwt:FlowPanel styleName="neo-ProjectToolbar-end">
        <controls:NeoButton action="VIEW_TRASH" variant="QUIET"/>
        <controls:NeoButton action="DELETE_PROJECT" variant="DANGER"/>
      </gwt:FlowPanel>
    </gwt:FlowPanel>

    <gwt:FlowPanel ui:field="trashButtons" styleName="neo-ProjectToolbar-end"
        visible="false">
      <controls:NeoButton action="RESTORE_PROJECT"/>
      <controls:NeoButton action="SWITCH_TO_PROJECTS" variant="QUIET"/>
      <controls:NeoButton action="DELETE_FOREVER" variant="DANGER"/>
    </gwt:FlowPanel>
  </gwt:FlowPanel>
</ui:UiBinder>
