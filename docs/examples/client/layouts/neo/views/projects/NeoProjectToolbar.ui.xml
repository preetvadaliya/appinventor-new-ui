<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:k="urn:import:com.google.appinventor.client.layouts.neo.kit">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="neo-ProjectToolbar">
    <g:Label ui:field="title" styleName="neo-ProjectToolbar-title"/>

    <g:FlowPanel ui:field="projectButtons" styleName="neo-ProjectToolbar-groups">
      <g:FlowPanel styleName="neo-ProjectToolbar-start">
        <k:NeoButton action="NEW_PROJECT" variant="PRIMARY"/>
        <k:NeoButton action="IMPORT_PROJECT"/>
        <k:NeoButton action="IMPORT_TEMPLATE"/>
        <k:NeoButton action="NEW_FOLDER"/>
      </g:FlowPanel>
      <g:FlowPanel styleName="neo-ProjectToolbar-center">
        <k:NeoButton action="MOVE_PROJECTS"/>
        <k:NeoMenuButton action="EXPORT">
          <k:NeoMenuItem action="EXPORT_PROJECT"/>
          <k:NeoMenuItem action="EXPORT_ALL_PROJECTS"/>
        </k:NeoMenuButton>
        <k:NeoButton action="LOGIN_TO_GALLERY"
            text="{messages.galleryTabName}"/>
        <k:NeoButton action="SEND_TO_GALLERY"
            text="{messages.publishButton}"/>
      </g:FlowPanel>
      <g:FlowPanel styleName="neo-ProjectToolbar-end">
        <k:NeoButton action="VIEW_TRASH" variant="QUIET"/>
        <k:NeoButton action="DELETE_PROJECT" variant="DANGER"/>
      </g:FlowPanel>
    </g:FlowPanel>

    <g:FlowPanel ui:field="trashButtons" styleName="neo-ProjectToolbar-end"
        visible="false">
      <k:NeoButton action="RESTORE_PROJECT"/>
      <k:NeoButton action="SWITCH_TO_PROJECTS" variant="QUIET"/>
      <k:NeoButton action="DELETE_FOREVER" variant="DANGER"/>
    </g:FlowPanel>
  </g:FlowPanel>
</ui:UiBinder>
