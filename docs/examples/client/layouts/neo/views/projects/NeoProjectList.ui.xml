<!-- Project list: one card with column headers, then the rows (they
     scroll). Rows are NeoProjectRow / NeoProjectFolder, one per item. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col neo-Card">

    <gwt:HTMLPanel styleName="flex-row items-center gap-sm neo-ListHeader">
      <controls:NeoCheckbox ui:field="selectAll"/>
      <gwt:FocusPanel ui:field="sortByName" styleName="grow neo-SortHeader">
        <gwt:InlineLabel ui:field="nameHeader" text="{messages.projectNameHeader}"/>
      </gwt:FocusPanel>
      <gwt:FocusPanel ui:field="sortByCreated" styleName="neo-DateColumn neo-SortHeader">
        <gwt:InlineLabel ui:field="createdHeader"
            text="{messages.projectDateCreatedHeader}"/>
      </gwt:FocusPanel>
      <gwt:FocusPanel ui:field="sortByModified" styleName="neo-DateColumn neo-SortHeader">
        <gwt:InlineLabel ui:field="modifiedHeader"
            text="{messages.projectDateModifiedHeader}"/>
      </gwt:FocusPanel>
    </gwt:HTMLPanel>

    <gwt:FlowPanel ui:field="rows" styleName="flex-col grow overflow-auto"/>

    <gwt:Label ui:field="empty" styleName="neo-Empty"
        text="{messages.createNoProjectsDialogText}" visible="false"/>

  </gwt:HTMLPanel>
</ui:UiBinder>
