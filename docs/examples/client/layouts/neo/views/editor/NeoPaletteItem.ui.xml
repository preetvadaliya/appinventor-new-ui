<!-- One component in the palette: neo's icon, name, help. Drag to the
     viewer. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls"
    xmlns:shared="urn:import:com.google.appinventor.client.controls">
  <gwt:FocusPanel ui:field="item" styleName="neo-PaletteItem">
    <gwt:HTMLPanel styleName="flex-row items-center gap-sm">
      <shared:IconView ui:field="icon"/>
      <gwt:InlineLabel ui:field="name" styleName="grow"/>
      <controls:NeoIconButton ui:field="help"/>
    </gwt:HTMLPanel>
  </gwt:FocusPanel>
</ui:UiBinder>
