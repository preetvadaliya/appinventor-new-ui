<!-- Blocks: drawers over media | blocks workspace -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:editor="urn:import:com.google.appinventor.client.layouts.neo.views.editor">
  <gwt:HTMLPanel styleName="flex-row grow overflow-auto gap-md pad-md">
    <gwt:HTMLPanel styleName="flex-col neo-DrawersColumn gap-md">
      <editor:NeoBlockDrawers ui:field="drawers" addStyleNames="grow"/>
      <editor:NeoMedia ui:field="media" addStyleNames="neo-MediaPane"/>
    </gwt:HTMLPanel>
    <editor:NeoBlocksWorkspace ui:field="workspace" addStyleNames="grow neo-ViewerColumn"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
