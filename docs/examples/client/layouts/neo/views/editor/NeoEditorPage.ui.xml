<!-- Like React: {mode === DESIGNER ? <Designer/> : <Blocks/>}.
     Two separate areas instead of one area with hidden panes. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:editor="urn:import:com.google.appinventor.client.layouts.neo.views.editor"
    xmlns:console="urn:import:com.google.appinventor.client.features.console">
  <gwt:HTMLPanel styleName="flex-col grow">
    <editor:NeoDesignToolbar ui:field="toolbar"/>

    <editor:NeoDesignerArea ui:field="designer"/>
    <editor:NeoBlocksArea ui:field="blocks" visible="false"/>

    <console:ConsolePanel ui:field="console" visible="false"
        addStyleNames="overflow-auto neo-Console"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
