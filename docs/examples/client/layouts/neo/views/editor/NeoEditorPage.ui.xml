<!--
  Project editor for both the Designer and the Blocks editor. Same panes as
  classic, arranged as neo cards with titles; each card scrolls its body.
-->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:g="urn:import:com.google.gwt.user.client.ui"
    xmlns:ed="urn:import:com.google.appinventor.client.layouts.neo.views.editor"
    xmlns:box="urn:import:com.google.appinventor.client.features.workspace.boxes"
    xmlns:con="urn:import:com.google.appinventor.client.features.console">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <g:FlowPanel styleName="neo-Page neo-EditorPage">
    <ed:NeoDesignToolbar ui:field="toolbar"/>

    <g:FlowPanel ui:field="work" styleName="neo-Work is-designer">
      <box:PaletteBox ui:field="palette" styleName="neo-Card neo-Work-palette"/>
      <box:ViewerBox ui:field="viewer" styleName="neo-Card neo-Work-viewer"/>
      <g:FlowPanel styleName="neo-Work-side">
        <box:SourceStructureBox ui:field="components"
            styleName="neo-Card neo-Work-components"/>
        <box:BlockSelectorBox ui:field="drawers"
            styleName="neo-Card neo-Work-drawers"/>
        <g:FlowPanel styleName="neo-Card neo-Work-assets">
          <g:Label styleName="neo-Card-title"
              text="{messages.assetListBoxCaption}"/>
          <box:AssetListBox ui:field="assets" styleName="neo-Scroll"/>
        </g:FlowPanel>
      </g:FlowPanel>
      <box:PropertiesBox ui:field="properties"
          styleName="neo-Card neo-Work-properties"/>
    </g:FlowPanel>

    <con:ConsolePanel ui:field="console" styleName="neo-Console"
        visible="false"/>
  </g:FlowPanel>
</ui:UiBinder>
