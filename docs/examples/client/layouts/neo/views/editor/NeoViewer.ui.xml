<!-- Viewer card. Neo puts the preview options in the card's title row,
     then the phone, then the non-visible components. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col neo-Card">
    <!-- options are filled by ViewerPresenter -->
    <gwt:HTMLPanel styleName="flex-row items-center flex-wrap gap-md neo-Card-title">
      <gwt:InlineLabel styleName="grow" text="{messages.viewerBoxCaption}"/>
      <controls:NeoCheckbox ui:field="showHidden"
          label="{messages.showHiddenComponentsCheckbox}"/>
      <controls:NeoSelect ui:field="deviceSize" label="{messages.previewDeviceSize}"/>
      <controls:NeoSelect ui:field="previewStyle"
          label="{messages.previewOperatingSystem}"/>
    </gwt:HTMLPanel>

    <!-- the phone; the screen being designed (MockForm) goes in the slot -->
    <gwt:HTMLPanel styleName="flex-row grow overflow-auto pad-md">
      <gwt:HTMLPanel styleName="flex-col neo-PhoneFrame">
        <gwt:SimplePanel ui:field="screen" styleName="flex-col grow"/>
      </gwt:HTMLPanel>
    </gwt:HTMLPanel>

    <!-- non-visible components (Clock, TinyDB …), added in Java -->
    <gwt:HTMLPanel styleName="flex-col gap-sm pad-md neo-NonVisible">
      <gwt:Label ui:field="nonVisibleHeading" styleName="neo-Muted" visible="false"
          text="{messages.nonVisibleComponentsHeader}"/>
      <gwt:FlowPanel ui:field="nonVisible" styleName="flex-row flex-wrap gap-sm"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
