<!-- Blocks card: built-in drawers, then one per component. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col neo-Card">
    <gwt:HTMLPanel styleName="flex-row items-center neo-Card-title">
      <gwt:InlineLabel text="{messages.blockSelectorBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col grow overflow-auto gap-sm pad-md">
      <gwt:Label text="{messages.builtinBlocksLabel}" styleName="neo-Muted"/>
      <!-- Control, Logic, Math … added in Java, each with its icon -->
      <gwt:FlowPanel ui:field="builtIn" styleName="flex-col"/>
      <controls:NeoTree ui:field="components"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
