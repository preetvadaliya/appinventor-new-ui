<!-- Properties card: which component, then its properties by category.
     Categories (NeoCollapsible) and rows (NeoPropertyRow) are added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col neo-Card">
    <gwt:HTMLPanel styleName="flex-row items-center neo-Card-title">
      <gwt:InlineLabel text="{messages.propertiesBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col pad-md neo-PropertiesHeader">
      <gwt:Label ui:field="componentName" styleName="neo-Title"/>
      <gwt:Label ui:field="componentType" styleName="neo-Muted"/>
    </gwt:HTMLPanel>

    <gwt:FlowPanel ui:field="categories" styleName="flex-col grow overflow-auto"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
