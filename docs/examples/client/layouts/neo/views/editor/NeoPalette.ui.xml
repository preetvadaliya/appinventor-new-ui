<!-- Palette card: search, then the component categories. Categories
     (NeoCollapsible) and their items (NeoPaletteItem) are added in Java. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <ui:with field="messages" type="com.google.appinventor.client.core.i18n.OdeMessages"/>
  <gwt:HTMLPanel styleName="flex-col neo-Card">
    <gwt:HTMLPanel styleName="flex-row items-center neo-Card-title">
      <gwt:InlineLabel text="{messages.paletteBoxCaption}"/>
    </gwt:HTMLPanel>

    <gwt:HTMLPanel styleName="flex-col grow overflow-auto gap-sm pad-md">
      <controls:NeoTextField ui:field="search"
          placeholder="{messages.searchComponents}"/>
      <gwt:FlowPanel ui:field="results" styleName="flex-col" visible="false"/>
      <gwt:FlowPanel ui:field="categories" styleName="flex-col gap-xs"/>
      <controls:NeoButton ui:field="importExtension" variant="QUIET"
          text="{messages.importExtensionMenuItem}"/>
    </gwt:HTMLPanel>
  </gwt:HTMLPanel>
</ui:UiBinder>
