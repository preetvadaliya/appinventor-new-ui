<!-- NeoMenuItem: one row in a menu; icon and label from the bound action. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <gwt:FocusPanel ui:field="item" styleName="neo-MenuItem">
    <gwt:HTMLPanel styleName="flex-row items-center gap-md">
      <controls:IconView ui:field="icon"/>
      <gwt:InlineLabel ui:field="label" styleName="grow"/>
      <gwt:InlineLabel ui:field="shortcut" styleName="neo-MenuItem-shortcut"/>
    </gwt:HTMLPanel>
  </gwt:FocusPanel>
</ui:UiBinder>
