<!-- NeoMenuButton: a <button> with the icon (when bound to an action),
     caption and a caret; opens NeoMenu below it. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <gwt:HTMLPanel tag="button" ui:field="root"
      styleName="flex-row items-center gap-sm neo-MenuButton">
    <controls:IconView ui:field="icon"/>
    <gwt:InlineLabel ui:field="caption"/>
    <gwt:InlineLabel styleName="neo-MenuButton-caret" text="&#x25BE;"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
