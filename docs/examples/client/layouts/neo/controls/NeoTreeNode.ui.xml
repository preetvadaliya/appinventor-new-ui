<!-- NeoTreeNode: what one NeoTree item shows, an optional icon
     and its caption. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:shared="urn:import:com.google.appinventor.client.controls">
  <gwt:HTMLPanel styleName="flex-row items-center gap-xs neo-TreeNode">
    <shared:IconView ui:field="icon"/>
    <gwt:InlineLabel ui:field="caption"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
