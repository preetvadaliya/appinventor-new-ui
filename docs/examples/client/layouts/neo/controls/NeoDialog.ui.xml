<!-- NeoDialog: a rounded card with a title row and a close button, then
     the content. NeoDialog.java puts this in a modal popup and adds
     DialogA11y. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.layouts.neo.controls">
  <gwt:HTMLPanel styleName="flex-col neo-Card neo-Dialog">
    <gwt:HTMLPanel styleName="flex-row items-center neo-Card-title">
      <gwt:Label ui:field="caption" styleName="grow"/>
      <controls:NeoIconButton ui:field="close"/>
    </gwt:HTMLPanel>
    <gwt:SimplePanel ui:field="content" styleName="flex-col pad-md"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
