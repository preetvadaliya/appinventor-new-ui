<!-- NeoTextField: label, rounded input, error message under it. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel styleName="flex-col gap-xs neo-TextField">
    <gwt:Label ui:field="label" styleName="neo-Label"/>
    <gwt:TextBox ui:field="input" styleName="neo-Input"/>
    <gwt:Label ui:field="error" styleName="neo-Error" visible="false"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
