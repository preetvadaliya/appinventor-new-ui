<!-- NeoSelect: label and a rounded drop-down list. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui">
  <gwt:HTMLPanel styleName="flex-col gap-xs neo-Select">
    <gwt:Label ui:field="label" styleName="neo-Label"/>
    <gwt:ListBox ui:field="list" styleName="neo-Input"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
