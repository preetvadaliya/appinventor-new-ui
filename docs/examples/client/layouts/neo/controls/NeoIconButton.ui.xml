<!-- NeoIconButton: a round <button> with one Material glyph (help, close).
     It has no visible text, so its name goes in aria-label and title. -->
<ui:UiBinder xmlns:ui="urn:ui:com.google.gwt.uibinder"
    xmlns:gwt="urn:import:com.google.gwt.user.client.ui"
    xmlns:controls="urn:import:com.google.appinventor.client.controls">
  <gwt:HTMLPanel tag="button" ui:field="root" styleName="neo-IconButton">
    <controls:IconView ui:field="icon"/>
  </gwt:HTMLPanel>
</ui:UiBinder>
